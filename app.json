{
  "expo": {
    "name": "Control Vehicular",
    "slug": "ControlVehicular-React",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.gaober.ControlVehicularReact",
      "versionCode": 1,

      "permissions": [
        "INTERNET"
      ],

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },

      "edgeToEdgeEnabled": false
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "extra": {
      "eas": {
        "projectId": "c31b4f5f-26a0-4f8b-94a4-804b3c23d090"
      }
    },

    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}