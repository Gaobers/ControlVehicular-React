{
  "name": "controlvehicular-react",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node -e \"require('fs').mkdirSync('reports/component-tests',{recursive:true})\" && jest --watchAll=false --runInBand",
    "test:report": "node -e \"require('fs').mkdirSync('reports/component-tests',{recursive:true})\" && jest --watchAll=false --runInBand --json --outputFile=reports/component-tests/test-results.json",
    "test:coverage": "node -e \"require('fs').mkdirSync('reports/component-tests',{recursive:true})\" && jest --watchAll=false --runInBand --coverage",
    "test:reports": "node -e \"require('fs').mkdirSync('reports/component-tests',{recursive:true})\" && jest --watchAll=false --runInBand --coverage --json --outputFile=reports/component-tests/test-results.json"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "axios": "^1.20.0",
    "expo": "~54.0.36",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "jest": "29.7.0",
    "jest-expo": "54.0.18",
    "jest-html-reporter": "4.4.2",
    "react-test-renderer": "19.1.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/components/**/*.{js,jsx}",
      "src/hooks/**/*.{js,jsx}",
      "!src/components/**/__tests__/**",
      "!src/components/**/__mocks__/**",
      "!src/components/**/*.test.js",
      "!src/components/**/*.test.jsx",
      "!src/components/**/*.spec.js",
      "!src/components/**/*.spec.jsx",
      "!src/hooks/**/__tests__/**",
      "!src/hooks/**/__mocks__/**",
      "!src/hooks/**/*.test.js",
      "!src/hooks/**/*.test.jsx",
      "!src/hooks/**/*.spec.js",
      "!src/hooks/**/*.spec.jsx",
      "!src/components/common/DatePickerField.web.js"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "json-summary",
      "lcov"
    ],
    "reporters": [
      "default",
      [
        "jest-html-reporter",
        {
          "pageTitle": "Control Vehicular - Resultados de pruebas de componentes",
          "outputPath": "reports/component-tests/test-results.html",
          "dateFormat": "yyyy-mm-dd HH:MM:ss",
          "includeFailureMsg": true,
          "includeSuiteFailure": true,
          "includeStackTrace": true,
          "sort": "status"
        }
      ]
    ]
  }
}
